# Google OAuth – get your Client ID from console.cloud.google.com
# Create a project → Credentials → OAuth 2.0 Client ID (Web application)
# Add http://localhost:5000 and https://pestflow.org to Authorized JavaScript Origins
# Add http://localhost:5000/login and https://pestflow.org/login to Authorized Redirect URIs
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Mobile Text Alerts: used to add every site lead submission as a subscriber.
# MTA_MARKETING_GROUP_IDS is comma-separated; use the PestFlow group id(s).
MTA_MARKETING_API_KEY=
MTA_MARKETING_GROUP_IDS=

# Exact request-IP deny list (comma-separated IPv4/IPv6 addresses)
PESTFLOW_BLOCKED_IPS=""

# Calendly booking-to-admin ledger. The webhook subscription URL should be:
# https://pestflow.org/api/calendly/webhook?token=<CALENDLY_WEBHOOK_SECRET>
# Scope the subscription to invitee.created for the PestFlow booking owner.
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SECRET=
CALENDLY_PESTFLOW_EVENT_TYPE_URI=
